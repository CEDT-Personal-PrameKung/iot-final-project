# Backend environment configuration
APP_ENV=development
# Comma-separated frontend origins, with no trailing slash. Example:
# CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Neon PostgreSQL URL. Keep sslmode=require in the connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Optional Tiger Cloud PostgreSQL URL for time-series telemetry.
TELEMETRY_DATABASE_URL=
EMQX_HOST=
EMQX_PORT=8883
EMQX_USERNAME=
EMQX_PASSWORD=
APP_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
