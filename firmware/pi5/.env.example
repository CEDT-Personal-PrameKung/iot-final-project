# EMQX MQTT connection settings for the planned MQTT integration.
# Camera, model, parking zones, LEDs, and web server settings live in config.json.
MQTT_ENABLED=true
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=8883
MQTT_SOCKET_PORT=8084
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=raspberry-pi-ai-camera
MQTT_QOS=1
MQTT_KEEPALIVE=60
MQTT_TLS_ENABLED=true
MQTT_CA_CERT=emqx-ca.crt
